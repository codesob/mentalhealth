# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/mindheal"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Needed locally. On Vercel, NextAuth uses the deployment URL automatically.
NEXTAUTH_URL="http://localhost:3000"

# Optional: enable Google / GitHub sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# Optional: enables the assistant chat. Without it the endpoint returns 503.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4"
